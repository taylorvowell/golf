# Copy to apps/web/.env (gitignored) and fill in real values.
#
# This file must live in apps/web/, NOT the repo root: Next.js only auto-loads env files from
# the app directory, so NEXT_PUBLIC_* vars in a root .env are never inlined into the client
# bundle at build time. Interim setup — DECISIONS D10 moves secrets to Infisical at step 10.

# ---------------------------------------------------------------- local database
# TWO connections, and the difference is the authorization boundary (D42).
#
# DATABASE_URL is the OWNER: migrations, `db:seed`, `db:backfill`, `db:claim-fixtures`. It can
# bypass row-level security, which is why nothing serving a request is allowed to hold it —
# `src/db/admin.ts` throws if it is imported inside Next.
#
# APP_DATABASE_URL is what the RUNNING APP connects as: `swingsage_app`, a non-superuser with no
# BYPASSRLS and no route to `service_role`, created by migration 0008 and given its password by
# `pnpm --filter web db:app-role` (which `db:migrate` chains). There is deliberately no fallback
# to DATABASE_URL — falling back would silently restore the superuser connection that made every
# policy inert (D26). The app also refuses to start if this role turns out to be privileged.
#
# Both stay local so pipeline work, `pnpm db:backfill` and the analyzer keep running with no
# cloud credentials.
DATABASE_URL=postgres://swingsage:swingsage@127.0.0.1:5433/swingsage
APP_DATABASE_URL=postgres://swingsage_app:swingsage_app@127.0.0.1:5433/swingsage

# The password `db:app-role` sets on swingsage_app. Unset is fine for a loopback DATABASE_URL
# (it uses a well-known local value); against any other host the script refuses to run without it.
APP_DATABASE_PASSWORD=

# Where the analyzer's out/<swingId>/ folders live. Defaults to ../../services/analyzer/out
# relative to apps/web if unset — see src/lib/swings.ts.
# SWINGSAGE_MEDIA_ROOT=

# ---------------------------------------------------------------- supabase: browser-visible
# Inlined into the client bundle at BUILD time. Publishable by design — safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---------------------------------------------------------------- supabase: server-only
# NEVER prefix these NEXT_PUBLIC_, never import them from a "use client" module, and never
# let them reach a request handler.

# Dashboard -> Project Settings -> API keys -> secret key (sb_secret_...).
# Bypasses row-level security completely — which is its purpose (the analyzer worker writes
# artifacts for users it is not authenticated as, D7) and also why a leak voids every policy.
SUPABASE_SECRET_KEY=

# Dashboard -> Project Settings -> Database -> Connection string -> URI.
# Use the DIRECT / session connection, NOT the transaction pooler: Drizzle migrations use DDL
# and prepared statements, which do not survive transaction-mode pooling.
SUPABASE_CONNECTION_URL=

# JWKS endpoint for verifying Supabase-issued JWTs locally instead of round-tripping to the
# auth server on every request.
SUPABASE_JWKS_URL=

# Comma-separated allowlist. Unset = no restriction.
#
# If you set it, include `session-probe@swingsage.invalid` — `pnpm --filter web verify:account`
# (§4.2's two-device proof) signs in as that address, and an allowlist rejection there is a 401
# indistinguishable from a session failure.
AUTH_ALLOWED_EMAILS=

# Development-only auth bypass. A request that presents no identity resolves to this one. The app
# refuses to start if it is set in a production build. Leave unset unless deliberately working
# ahead of sign-in.
#
# It does NOT apply to a request carrying `Authorization: Bearer` — a presented identity always
# wins. That is what keeps a native sign-in test honest: with the fallback in front, the phone
# would authenticate whatever its token said (D43).
DEV_USER_EMAIL=

# --- media storage (step 09) ---
# Which media driver serves swing artifacts. Cloud is OPT-IN and never inferred from the Supabase
# vars above, because those are set for auth while media may still be local.
#   local (default)  object keys become directories under MEDIA_STORE_ROOT; no credentials needed
#   supabase         Supabase Storage per D8; run `pnpm --filter web media:provision` first
MEDIA_DRIVER=local
# Where the local driver puts bytes. Defaults to `.media/` at the repo root.
MEDIA_STORE_ROOT=
# The analyzer's WORKING directory root — `out/<stem>/`, what burnin.py writes. No longer the
# source of truth for media; only the publish step reads it. Defaults to services/analyzer/out.
SWINGSAGE_MEDIA_ROOT=

# --- analysis jobs (analyzer-service step 04) ---
# Which path runs an analysis job. Queue is OPT-IN and never inferred, same rule as
# MEDIA_DRIVER: QStash configuration being present must not silently reroute analysis.
#   spawn (default)  the analyzer runs as a child process of this server (local dev)
#   queue            jobs publish to QStash and run on the hosted worker
JOBS_DRIVER=spawn
# QStash. For local development run `npx @upstash/qstash-cli dev` (port 8080) and use the
# QSTASH_URL/QSTASH_TOKEN it prints — no Upstash account needed. Production values are part of
# the worker-host deploy (OPEN handoff row).
QSTASH_URL=
QSTASH_TOKEN=
# Where QStash delivers jobs: the worker server's public URL, e.g. http://localhost:8787/jobs.
# The worker verifies signatures against EXACTLY this URL (WORKER_PUBLIC_URL on its side).
WORKER_URL=
# The base URL the WORKER uses to reach this app's /api/internal routes. On a LAN this is the
# machine's LAN address, never localhost (phones and workers are not this machine).
APP_INTERNAL_BASE_URL=
# Signs the per-job tokens the worker presents back. Any long random string; >= 16 chars.
WORKER_CALLBACK_SECRET=
# The club-detector weights path ON THE WORKER, or the literal string `none` for the classical
# path. Required when JOBS_DRIVER=queue — never defaulted, never silent (the standing trap).
WORKER_CLUB_DETECTOR=runs/clubhead/weights/best.pt

# --- queue policy (analyzer-service step 05) — all optional, defaults in lib/jobs/policy.ts ---
# Concurrent QStash deliveries per user (flow-control key = the enqueuing user). Fairness:
# one golfer's burst queues behind itself, never in front of everyone else.
#JOBS_FLOW_PARALLELISM=1
# Active (queued+running) queue jobs one user may hold across all their swings; exceeding it
# refuses the enqueue with a user-readable error rather than piling up silently.
#JOBS_MAX_ACTIVE_PER_USER=3
# Orphan sweep: how long a RUNNING job may go without any worker event before the next poll
# settles it failed. Must survive the club stage's multi-minute quiet stretch on CPU.
#JOBS_QUEUE_HEARTBEAT_TIMEOUT_S=900
# Orphan sweep: how long a QUEUED job may wait for its first event — covers QStash's whole
# retry schedule. The failure callback usually settles undelivered jobs first; this is the
# backstop.
#JOBS_QUEUE_PENDING_TIMEOUT_S=3600
