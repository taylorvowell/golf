# Prebuild output — regenerated by `npx expo prebuild`, never edited by hand (CNG).
/android
/ios

# Gradle/Xcode output inside local native modules. The module SOURCE is committed; its build
# products are not — `modules/*/android/build` is regenerated by every `expo run:android`.
modules/*/android/build/
modules/*/android/.cxx/
modules/*/ios/build/

# Generated spike assets. `scripts/make_real_clip.py` rebuilds them from services/analyzer/out/,
# which is itself gitignored — so these are reproducible, not source, and an 8MB binary does not
# belong in history.
assets/*-stamped.mp4
assets/*-pose.json
