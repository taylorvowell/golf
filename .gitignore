# --- Python analyzer ---
services/analyzer/.venv/
__pycache__/
*.pyc

# Model weights, downloaded on demand — see docs/RUNBOOK.md "Rebuilding the analyzer
# environment" for what each asset is and how it is obtained.
# Ultralytics also drops base checkpoints in the working dir, hence the bare patterns.
*.task
*.onnx
*.pt

# Training datasets (Roboflow, CC BY 4.0) and training runs. Large, and re-downloadable.
services/analyzer/datasets/
services/analyzer/runs/
*.log
*.err

# Per-swing analysis output: normalized video, analysis.json, diagnostic renders.
# Regenerated by scripts/burnin.py; keep the source clips instead.
services/analyzer/out/

# Local test footage. fixtures/*.mp4 are the analysis-ready clips the pipeline and
# tests run against; fixtures/raw/ holds the uncompressed phone originals (270-330MB
# each, over GitHub's 100MB limit). All of it is local-only scratch for now — real
# fixture management moves to object storage with the hosted analyzer.
fixtures/

# --- Next.js web app ---
node_modules/
.next/
apps/web/next-env.d.ts

# --- secrets ---
.env
.env.local
*.key
*.local.txt

# --- OS ---
Thumbs.db
.DS_Store

# The local media store (lib/media/localStore.ts). Hard-linked from services/analyzer/out,
# so it costs no real disk — but it is media, and it is rebuildable with `pnpm db:backfill`.
.media/
.vercel
.env*

# Where the phone's wireless-debugging port was last seen (scripts/adb-phone.mjs).
.adb-phone.json

# Upstash CLI credentials (Developer API key)
.upstash.json
