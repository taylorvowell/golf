{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "swingsage://groundtruth/club-pose-labels/v1",
  "title": "club-pose-labels",
  "description": "Hand-labeled 5-point club pose for selected frames of one clip. Frames are on the NORMALIZED clock - the artifact's public frame identity (ANNOTATION-MANUAL.md SS0) - with fps recorded for the staleness guard; coordinates are normalized 0-1, x right, y down.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "clip", "clock", "fps", "annotator", "labeled_intervals", "frames"],
  "properties": {
    "schema": { "const": "club-pose-labels" },
    "schema_version": { "const": 1 },
    "clip": { "type": "string", "minLength": 1, "description": "Fixture stem or capture id the frames index into." },
    "clock": { "const": "normalized" },
    "fps": { "type": "number", "exclusiveMinimum": 0, "description": "The artifact video.fps the labels were made against. An evaluator seeing a different artifact fps flags these labels STALE and refuses to score." },
    "club_type": { "type": "string", "enum": ["driver", "wood", "hybrid", "iron", "wedge", "unknown"] },
    "annotator": { "type": "string", "minLength": 1 },
    "annotated_at": { "type": "string", "description": "ISO-8601 date or datetime." },
    "provenance": { "type": "string", "enum": ["manual", "player_correction", "model_preannotated_corrected"], "default": "manual" },
    "manual_version": { "type": "string", "description": "Git-identifiable version of ANNOTATION-MANUAL.md the labels were made under." },
    "notes": { "type": "string" },
    "labeled_intervals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_frame", "end_frame"],
        "properties": {
          "start_frame": { "type": "integer", "minimum": 0 },
          "end_frame": { "type": "integer", "minimum": 0, "description": "Inclusive." }
        }
      },
      "description": "The intervals the annotator committed to labeling every frame of. A frame inside an interval with no row is an ERROR; outside, absence means unlabeled."
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frame", "blur", "annotator_confidence", "points"],
        "properties": {
          "frame": { "type": "integer", "minimum": 0 },
          "blur": { "type": "string", "enum": ["none", "mild", "heavy", "shaft_streak", "head_streak", "unusable"] },
          "annotator_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "notes": { "type": "string" },
          "points": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "grip": { "$ref": "#/definitions/point" },
              "shaft_mid": { "$ref": "#/definitions/point" },
              "hosel": { "$ref": "#/definitions/point" },
              "head_a": { "$ref": "#/definitions/point" },
              "head_b": { "$ref": "#/definitions/point" },
              "head_center": { "$ref": "#/definitions/point" }
            },
            "description": "All of grip/shaft_mid/hosel/head_a/head_b expected unless blur=unusable (then empty) or a point is out_of_frame. head_center is DIRECT-LABEL ONLY for imported player corrections (provenance player_correction); manual 5-point labels derive it from head_a/head_b instead."
          }
        }
      }
    }
  },
  "definitions": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "v": { "type": "string", "enum": ["visible", "occluded", "out_of_frame"] }
      },
      "allOf": [
        {
          "if": { "properties": { "v": { "enum": ["visible", "occluded"] } } },
          "then": { "required": ["x", "y", "v"] }
        }
      ]
    }
  }
}
