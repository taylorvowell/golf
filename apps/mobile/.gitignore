# Prebuild output — regenerated by `npx expo prebuild`, never edited by hand (CNG).
/android
/ios

# Gradle/Xcode output inside local native modules. The module SOURCE is committed; its build
# products are not — all of this is regenerated by every `expo run:android`. `.gradle/` holds
# machine-local lock files and binary caches and was leaking into commits until 2026-08-12.
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/
modules/*/ios/build/
