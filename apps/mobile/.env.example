# Copy to apps/mobile/.env (gitignored) when the mobile app starts talking to Supabase.
# Nothing here is needed yet — apps/mobile is still the step 02 spike harness.
#
# Expo uses the EXPO_PUBLIC_ prefix, Next.js uses NEXT_PUBLIC_. The same Supabase values
# therefore need different variable names in each app, which is why apps/web and apps/mobile
# keep separate env files rather than sharing one at the repo root.

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---------------------------------------------------------------- google sign-in (D31)
# Both are CLIENT IDS, and both are public — they identify the app, they do not authenticate it.
# The Web client's SECRET is not here and never will be: it lives only in the Supabase dashboard
# (Authentication -> Sign In / Providers -> Google), which is the only party that needs it. An
# Android OAuth client has no secret at all; it is bound to the package name + signing SHA-1.
#
# Native sign-in asks Google for an ID token whose AUDIENCE is the WEB client, then hands it to
# Supabase's signInWithIdToken. That is why the web id is needed on the phone: the Android client
# identifies the caller, the web client is who the token is minted for. Getting this pair the
# wrong way round produces a token Supabase rejects with no useful error.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<id>.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=<id>.apps.googleusercontent.com


# =============================================================================
#  NOTHING SECRET GOES IN THIS FILE. EVER.
# =============================================================================
#
# A mobile binary is an untrusted client. EXPO_PUBLIC_ values are compiled into the app
# bundle, and even non-prefixed values can be recovered from a shipped build — so there is no
# such thing as a secret that is "hidden" in a mobile app.
#
# In particular the Supabase SECRET key must never appear here. It bypasses row-level
# security entirely, so shipping it inside an installable app would hand every user
# unrestricted read and write access to every other user's swings and video.
#
# Anything privileged belongs behind the API, which holds the secret server-side and enforces
# entitlement and RLS on the caller's behalf (DECISIONS D7, D16, D17).
