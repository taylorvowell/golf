{
  "name": "swingsage",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "schema:check": "pnpm --filter @swingsage/schema check",
    "schema:generate": "pnpm --filter @swingsage/schema generate"
  }
}
