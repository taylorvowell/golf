{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swingsage.dev/schemas/coach-report.schema.json",
  "title": "CoachReport",
  "description": "The deterministic scorecard for one swing — Stage 8's whole output, written as its own artifact rather than folded into `analysis.json`.\n\nIt is separate on purpose. Stage 8 is a pure function of `analysis.json` plus a versioned `scoring_config`, so a scoring change re-runs `rescore.py` over existing artifacts and never touches the CV contract. `scoring_model_version` is stored on every report so an old report stays reproducible against the config it was scored with.\n\nNo AI is involved. A narrative model may later replace the wording, but a swing reaches `ready` on this alone.",
  "type": "object",
  "required": [
    "scoring_model_version",
    "club_type",
    "view",
    "overall",
    "band",
    "arc_shift",
    "coverage",
    "categories",
    "checkpoints",
    "findings",
    "priorities",
    "primary",
    "drill"
  ],
  "properties": {
    "scoring_model_version": {
      "type": "string",
      "description": "Which scoring_config/<version>.json produced these numbers. Thresholds are never hardcoded, so this is what makes an old report reproducible."
    },
    "club_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "driver",
        "irons",
        null
      ],
      "description": "Selects club-aware bands. Null when the club was not declared, in which case club-specific checks abstain."
    },
    "view": {
      "type": "string"
    },
    "overall": {
      "type": [
        "number",
        "null"
      ],
      "description": "Weighted over the individual measured CHECKS, not an unweighted mean of the category scores — a thin category must not move the headline as much as a broad one. Null when nothing was measurable."
    },
    "band": {
      "type": [
        "string",
        "null"
      ]
    },
    "arc_shift": {
      "type": [
        "number",
        "null"
      ],
      "description": "No deterministic basis yet — always null. Typed rather than dropped so a future real signal needs no shape change."
    },
    "coverage": {
      "$ref": "#/definitions/coverage"
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/category"
      }
    },
    "checkpoints": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/checkpointScore"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/finding"
      }
    },
    "priorities": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/priority"
      }
    },
    "primary": {
      "$ref": "#/definitions/primaryFix"
    },
    "drill": {
      "$ref": "#/definitions/drill"
    }
  },
  "definitions": {
    "coverage": {
      "title": "ScoreCoverage",
      "type": "object",
      "description": "How much of the config produced a number for this swing, split by WHY the rest did not. Without this the headline score is unfalsifiable — a reader cannot tell a well-covered 65 from one resting on four checks.",
      "required": [
        "scored",
        "skipped_this_swing",
        "deferred_in_config",
        "total_checks"
      ],
      "properties": {
        "scored": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_this_swing": {
          "type": "integer",
          "minimum": 0,
          "description": "Skipped for something about THIS clip — wrong club, wrong view, low confidence."
        },
        "deferred_in_config": {
          "type": "integer",
          "minimum": 0,
          "description": "Abstaining on every swing because the metric behind them is not trustworthy yet. Our gap, not the golfer's — and the two must read differently."
        },
        "total_checks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checkBand": {
      "title": "CheckBand",
      "type": "object",
      "required": [
        "min",
        "max",
        "falloff"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "falloff": {
          "type": "number",
          "description": "How far past the edge the score decays to zero — every check is a distance from its band with a soft falloff."
        }
      }
    },
    "leverageBreakdown": {
      "title": "LeverageBreakdown",
      "type": "object",
      "properties": {
        "severity": {
          "type": "number",
          "description": "How far off the target this swing measured (100 − score)."
        },
        "impact": {
          "type": "number",
          "description": "How much this check matters to strike quality, distance and accuracy — the authored causal weight, 1–100."
        },
        "ease": {
          "type": "number",
          "description": "How quick a fix this is, inverted from the authored 1 (quick) … 5 (deep pattern change) effort rating onto a 0–100 scale."
        }
      },
      "required": [
        "severity",
        "impact",
        "ease"
      ]
    },
    "check": {
      "title": "CheckResult",
      "type": "object",
      "required": [
        "id",
        "label",
        "category",
        "weight",
        "field",
        "fix",
        "unit",
        "checkpoint",
        "value",
        "score",
        "skip_reason",
        "advice",
        "leverage",
        "leverage_breakdown",
        "effort",
        "kind",
        "band",
        "abs_value",
        "good_values",
        "deferred"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "weight": {
          "type": "number"
        },
        "field": {
          "type": "string",
          "description": "The field in `analysis.json.metrics` this check reads — what an overlay needs in order to know which angle to draw."
        },
        "fix": {
          "type": "string"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        },
        "skip_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "advice": {
          "type": [
            "string",
            "null"
          ],
          "description": "Plain-language, DIRECTIONAL 'what to do differently'. Null when the check is already in band or was not measured. Never the technical label."
        },
        "leverage": {
          "type": [
            "number",
            "null"
          ],
          "description": "Severity + impact + ease, equal thirds. Null when unscored."
        },
        "leverage_breakdown": {
          "anyOf": [
            {
              "$ref": "#/definitions/leverageBreakdown"
            },
            {
              "type": "null"
            }
          ]
        },
        "effort": {
          "type": "number"
        },
        "kind": {
          "type": "string",
          "enum": [
            "band",
            "categorical"
          ]
        },
        "band": {
          "description": "Null for categorical checks — see `good_values`.",
          "anyOf": [
            {
              "$ref": "#/definitions/checkBand"
            },
            {
              "type": "null"
            }
          ]
        },
        "abs_value": {
          "type": "boolean"
        },
        "good_values": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "deferred": {
          "type": "boolean",
          "description": "The config itself marks this check as not-yet-honestly-measurable, so it abstains on EVERY swing. `skip_reason` alone cannot distinguish that from 'your clip did not support it', and the two mean opposite things to a golfer."
        }
      }
    },
    "category": {
      "title": "CategoryResult",
      "type": "object",
      "required": [
        "category",
        "score",
        "n_measurable",
        "n_total",
        "n_deferred",
        "checks"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        },
        "n_measurable": {
          "type": "integer",
          "minimum": 0
        },
        "n_total": {
          "type": "integer",
          "minimum": 0,
          "description": "Checks this config is actually trying to score — deferred ones are excluded, so 'n_measurable of n_total' reads as coverage of a real target."
        },
        "n_deferred": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/check"
          }
        }
      }
    },
    "checkpointScore": {
      "title": "CheckpointScore",
      "type": "object",
      "required": [
        "p",
        "label",
        "score",
        "n_measurable"
      ],
      "properties": {
        "p": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "n_measurable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "finding": {
      "title": "Finding",
      "type": "object",
      "required": [
        "tone",
        "icon",
        "title",
        "detail"
      ],
      "properties": {
        "tone": {
          "type": "string",
          "enum": [
            "positive",
            "negative"
          ]
        },
        "icon": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "priority": {
      "title": "Priority",
      "type": "object",
      "required": [
        "key",
        "checkpoint",
        "label",
        "score",
        "leverage",
        "cue"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "checkpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "leverage": {
          "type": "number"
        },
        "cue": {
          "type": "string"
        }
      }
    },
    "primaryFix": {
      "title": "PrimaryFix",
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "copy": {
          "type": "string"
        },
        "moment": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "leverage": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "checkpoint",
        "title",
        "copy",
        "moment",
        "score",
        "leverage"
      ]
    },
    "drill": {
      "title": "Drill",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "copy": {
          "type": "string"
        },
        "dose": {
          "type": "string"
        },
        "doseNote": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "copy",
        "dose",
        "doseNote"
      ]
    }
  }
}
