{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "swingsage://groundtruth/body-pose-labels/v1",
  "title": "body-pose-labels",
  "description": "Hand-labeled body keypoints for selected frames of one clip - event/scoring frames and metric-consumed joints only, never all-joints-all-frames (ANNOTATION-MANUAL.md SS4). Frames on the NORMALIZED clock with fps for the staleness guard; coordinates normalized 0-1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "clip", "clock", "fps", "annotator", "frames"],
  "properties": {
    "schema": { "const": "body-pose-labels" },
    "schema_version": { "const": 1 },
    "clip": { "type": "string", "minLength": 1 },
    "clock": { "const": "normalized" },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "annotator": { "type": "string", "minLength": 1 },
    "annotated_at": { "type": "string" },
    "manual_version": { "type": "string" },
    "notes": { "type": "string" },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frame", "annotator_confidence", "points"],
        "properties": {
          "frame": { "type": "integer", "minimum": 0 },
          "event": { "type": "string", "description": "Which labeled event this frame is (address/top/impact/...), when it is one." },
          "annotator_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "notes": { "type": "string" },
          "points": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["v"],
              "properties": {
                "x": { "type": "number", "minimum": 0, "maximum": 1 },
                "y": { "type": "number", "minimum": 0, "maximum": 1 },
                "v": { "type": "string", "enum": ["visible", "occluded", "out_of_frame"] }
              }
            },
            "description": "Keyed by the artifact's pose.keypoint_names entries (left_shoulder, right_hip, ...). Only labeled joints appear."
          }
        }
      }
    }
  }
}
