{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && pnpm db:app-role",
    "db:app-role": "node --env-file-if-exists=.env --import tsx src/db/appRole.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/db/seed.ts",
    "db:backfill": "node --env-file-if-exists=.env --import tsx src/db/backfill.ts",
    "db:claim-fixtures": "node --env-file-if-exists=.env --import tsx src/db/claimFixtures.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "media:provision": "node --env-file-if-exists=.env --import tsx src/db/provisionStorage.ts",
    "queue:e2e": "node --env-file-if-exists=.env --import tsx src/db/queueE2E.ts",
    "verify:account": "node --env-file-if-exists=.env --import tsx src/db/verifyAccount.ts",
    "verify:media": "node --env-file-if-exists=.env --import tsx src/db/verifyMedia.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@swingsage/schema": "workspace:*",
    "@upstash/qstash": "^2.11.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.8",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
