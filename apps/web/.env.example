# Copy to apps/web/.env (gitignored) and fill in real values.
#
# This file must live in apps/web/, NOT the repo root: Next.js only auto-loads env files from
# the app directory, so NEXT_PUBLIC_* vars in a root .env are never inlined into the client
# bundle at build time. Interim setup — DECISIONS D10 moves secrets to Infisical at step 10.

# ---------------------------------------------------------------- local database
# Local Postgres from docker-compose.yml at the repo root (port 5433, not 5432).
# Deliberately stays local so pipeline work, `pnpm db:backfill` and the analyzer keep
# running with no cloud credentials.
DATABASE_URL=postgres://swingsage:swingsage@127.0.0.1:5433/swingsage

# Where the analyzer's out/<swingId>/ folders live. Defaults to ../../services/analyzer/out
# relative to apps/web if unset — see src/lib/swings.ts.
# SWINGSAGE_MEDIA_ROOT=

# ---------------------------------------------------------------- supabase: browser-visible
# Inlined into the client bundle at BUILD time. Publishable by design — safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---------------------------------------------------------------- supabase: server-only
# NEVER prefix these NEXT_PUBLIC_, never import them from a "use client" module, and never
# let them reach a request handler.

# Dashboard -> Project Settings -> API keys -> secret key (sb_secret_...).
# Bypasses row-level security completely — which is its purpose (the analyzer worker writes
# artifacts for users it is not authenticated as, D7) and also why a leak voids every policy.
SUPABASE_SECRET_KEY=

# Dashboard -> Project Settings -> Database -> Connection string -> URI.
# Use the DIRECT / session connection, NOT the transaction pooler: Drizzle migrations use DDL
# and prepared statements, which do not survive transaction-mode pooling.
SUPABASE_CONNECTION_URL=

# JWKS endpoint for verifying Supabase-issued JWTs locally instead of round-tripping to the
# auth server on every request.
SUPABASE_JWKS_URL=

# Comma-separated allowlist. Unset = no restriction.
AUTH_ALLOWED_EMAILS=

# One-shot migration of pre-auth development fixtures onto the first real account. Leave unset.
CLAIM_LEGACY_FIXTURES=

# Development-only auth bypass. Every request resolves to this identity. The app refuses to start
# if it is set in a production build. Leave unset unless deliberately working ahead of sign-in.
DEV_USER_EMAIL=
