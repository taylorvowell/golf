{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "swingsage://groundtruth/event-labels/v1",
  "title": "event-labels",
  "description": "Hand-labeled swing event frames for one clip. Frames are on the NORMALIZED clock (the artifact's public frame identity) with fps recorded for the staleness guard; ms = (frame + 0.5) / fps * 1000. Definitions frozen in ANNOTATION-MANUAL.md SS2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "clip", "clock", "fps", "annotator", "events"],
  "properties": {
    "schema": { "const": "event-labels" },
    "schema_version": { "const": 1 },
    "clip": { "type": "string", "minLength": 1 },
    "clock": { "const": "normalized" },
    "fps": { "type": "number", "exclusiveMinimum": 0, "description": "The artifact video.fps the labels were made against. A different artifact fps means STALE labels; evaluators refuse to score them." },
    "annotator": { "type": "string", "minLength": 1 },
    "annotated_at": { "type": "string" },
    "manual_version": { "type": "string" },
    "verified_by": { "type": "string", "description": "Set when a human has reviewed a first-pass label set (e.g. Claude first pass, Taylor verify)." },
    "notes": { "type": "string" },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "top", "impact", "finish"],
      "properties": {
        "address": { "$ref": "#/definitions/event" },
        "takeaway": { "$ref": "#/definitions/event" },
        "toe_up": { "$ref": "#/definitions/event" },
        "mid_backswing": { "$ref": "#/definitions/event" },
        "top": { "$ref": "#/definitions/event" },
        "mid_downswing": { "$ref": "#/definitions/event" },
        "impact": { "$ref": "#/definitions/event" },
        "mid_follow_through": { "$ref": "#/definitions/event" },
        "finish": { "$ref": "#/definitions/event" }
      },
      "description": "Names are the artifact's own eight GolfDB events plus takeaway (which the artifact does not emit). address/top/impact/finish are required; a required event whose frame cannot be determined is present with frame=null and a reason in notes (abstention, counted by the evaluator) - never simply omitted."
    },
    "audio_region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms"],
      "properties": {
        "start_ms": { "type": "number", "minimum": 0 },
        "end_ms": { "type": "number", "minimum": 0 }
      },
      "description": "Waveform interval bracketing the strike transient, source clock."
    },
    "ball": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "last_present_frame": { "type": ["integer", "null"], "minimum": 0 },
        "first_moving_frame": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "second_annotator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotator", "events"],
      "properties": {
        "annotator": { "type": "string", "minLength": 1 },
        "annotated_at": { "type": "string" },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "address": { "$ref": "#/definitions/event" },
            "takeaway": { "$ref": "#/definitions/event" },
            "toe_up": { "$ref": "#/definitions/event" },
            "mid_backswing": { "$ref": "#/definitions/event" },
            "top": { "$ref": "#/definitions/event" },
            "mid_downswing": { "$ref": "#/definitions/event" },
            "impact": { "$ref": "#/definitions/event" },
            "mid_follow_through": { "$ref": "#/definitions/event" },
            "finish": { "$ref": "#/definitions/event" }
          }
        }
      }
    }
  },
  "definitions": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame", "confidence"],
      "properties": {
        "frame": { "type": ["integer", "null"], "minimum": 0 },
        "ms": { "type": ["number", "null"], "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
